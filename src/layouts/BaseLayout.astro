---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, waLink, type NavVariant } from '../lib/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';

/* No stylesheet is imported here on purpose. In the reference, each page is a
   single self-contained <style> block where base rules and page rules interleave;
   splitting that across two files reorders them and silently changes the cascade.
   So every page imports exactly one stylesheet: the 23 pages that share a
   stylesheet import styles/global.css, and the 7 that differ import their own
   file from styles/pages/. See README "Why some pages have their own stylesheet".

   The mobile layer IS imported here, deliberately: Astro emits a page's own
   stylesheet BEFORE the layout's, so importing it here puts it last — exactly
   where an override layer belongs. It contains only media-query rules, so the
   desktop rendering verified against the reference is untouched. */
import '../styles/mobile.css';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Always on the production domain. */
  canonical: string;
  /** One or more JSON-LD graphs, emitted verbatim in <head>. */
  jsonld?: Record<string, unknown>[];
  navVariant?: NavVariant;
  /** Header CTA overrides; see Header.astro. */
  ctaLabel?: string;
  ctaHref?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Set on pages that render their own breadcrumb markup, so the layout
   *  does not draw a second one. Remove as those pages are migrated. */
  ownCrumbs?: boolean;
  ogImage?: string;
  ogType?: string;
  /** AVIF path of the page's hero image, preloaded so it is not queued behind the fonts. */
  preloadImage?: string;
  /**
   * Keep the page out of the index but still follow its links. Used by term
   * archives holding a single post, which are otherwise a thin duplicate of
   * that post and compete with it. Such routes are also dropped from the
   * sitemap — see the `filter` in astro.config.mjs.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  jsonld = [],
  navVariant = 'inner',
  ownCrumbs = false,
  ctaLabel,
  ctaHref,
  ogTitle,
  ogDescription,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  preloadImage,
  noindex = false,
} = Astro.props;

// Sticky bottom CTA bar (replaces the removed header "Book" button). Points at
// the same booking target the header CTA used, per nav variant.
const bookHref = ctaHref ?? (navVariant === 'home' ? '#book' : '/#book');
const stickyWaText = 'Hi Qualis — I would like to book a furniture inspection in India.';

/* Breadcrumb trail, read off the page's own BreadcrumbList (2026-09 audit,
   IA-06). Pages that render their own crumb markup opt out with
   `ownCrumbs`, so nothing is drawn twice while those are migrated. */
interface CrumbItem { '@type'?: string; name?: string; item?: string }
const crumbGraph = jsonld.find((g) => g['@type'] === 'BreadcrumbList') as
  | { itemListElement?: CrumbItem[] }
  | undefined;
const crumbTrail = (crumbGraph?.itemListElement ?? [])
  .map((li) => ({ name: li.name ?? '', item: li.item }))
  .filter((c) => c.name);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="theme-color" content={SITE.themeColor}>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{SITE.ga4Id && (
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
  <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${SITE.ga4Id}');`}></script>
)}
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="canonical" href={canonical}>
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={ogDescription ?? description}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={SITE.siteName}>
<meta property="og:locale" content={SITE.locale}>
<meta name="twitter:card" content="summary_large_image">
<!-- .ico first as the universal fallback; browsers that understand the SVG
     prefer it via type. Google's favicon crawler also probes /favicon.ico
     at the site root regardless of what is declared here. -->
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/images/icon-180.png">
<!-- Self-hosted webfonts. The third-party Google Fonts request was render-blocking
     and cost FCP 3.3s vs 1.1s. Same woff2 files, same subsetting, same swap. -->
{preloadImage && (
  <link rel="preload" as="image" href={preloadImage} type="image/avif" fetchpriority="high" />
)}
<link rel="preload" href="/fonts/intertight-NGSwv5HMAFg6IuGlBNMjxLsH8ahuQ2e8.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
{jsonld.map((graph) => (
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
))}
<slot name="head" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Header variant={navVariant} ctaLabel={ctaLabel} ctaHref={ctaHref} />

<main id="main" tabindex="-1">
  {!ownCrumbs && <Breadcrumbs trail={crumbTrail} />}
  <slot />
</main>
<Footer />

<!-- Sticky bottom CTA bar — persistent Book + WhatsApp actions on every page. -->
<div class="sticky-cta" role="region" aria-label="Quick actions">
  <a class="sticky-cta__btn sticky-cta__book" href={bookHref}>Book an inspection</a>
  <a
    class="sticky-cta__btn sticky-cta__wa"
    href={waLink(stickyWaText)}
    target="_blank"
    rel="noopener"
  >WhatsApp</a>
</div>
<style is:global>
  /* Skip link: off-screen until focused, then the first thing a keyboard user
     lands on. `main` takes tabindex="-1" so the jump actually moves focus and
     not just the scroll position (Safari and Chrome both need that). */
  .skip-link {
    /* fixed, not absolute: absolute pins it to the top of the *document*, so it
       would slide in off-screen for anyone who reaches it after scrolling. */
    position: fixed;
    left: 8px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--ink, #111214);
    color: #fff;
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 6px 6px;
    transition: top .15s ease;
  }
  .skip-link:focus { top: 0; }
  main:focus { outline: none; }
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: none; /* mobile/tablet only — turned on in the media query below */
    gap: 10px;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgba(247, 246, 242, 0.97);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--rule, #e9e7e1);
    box-shadow: 0 -8px 24px -14px rgba(17, 18, 20, 0.35);
  }
  .sticky-cta__btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    padding: 0.9rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    border: 1.5px solid transparent;
  }
  .sticky-cta__book { background: var(--ink, #111214); color: #fff; }
  .sticky-cta__wa { background: var(--pass, #0f7a5a); color: #fff; }
  .sticky-cta__btn:active { transform: translateY(1px); }
  /* Hidden while the booking section is on screen (2026-09 audit, UX-10). On
     desktop the pair floats bottom-right and sat directly over the form's
     "No payment now" note and the third pricing card — offering a second Book
     button on top of the form the visitor is already filling in. Pointer
     events go too, so it cannot swallow a click on what is underneath. */
  .sticky-cta.sticky-cta--off {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
  }
  .sticky-cta { transition: opacity .2s ease, transform .2s ease, visibility .2s; }
  @media (prefers-reduced-motion: reduce) { .sticky-cta { transition: none; } }
  /* Mobile & tablet: full-width bottom bar. */
  @media (max-width: 960px) {
    .sticky-cta { display: flex; }
    body { padding-bottom: 78px; }
  }
  /* Narrow phones: "Book an inspection" wrapped to two lines at 320–375px,
     which pushed the bar taller than the padding reserved for it. Size the
     WhatsApp button to its content and let the label keep one line. */
  @media (max-width: 400px) {
    .sticky-cta { gap: 8px; padding-left: 10px; padding-right: 10px; }
    .sticky-cta__btn { font-size: .95rem; padding: .9rem .7rem; white-space: nowrap; }
    .sticky-cta__wa { flex: 0 0 auto; }
  }
  /* Desktop: the same two actions as floating buttons, bottom-right corner. */
  @media (min-width: 961px) {
    .sticky-cta {
      display: flex;
      flex-direction: column;
      left: auto;
      right: 22px;
      bottom: 22px;
      gap: 12px;
      padding: 0;
      background: none;
      border-top: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
    }
    .sticky-cta__btn {
      flex: 0 0 auto;
      min-width: 210px;
      padding: 0.95rem 1.5rem;
      border-radius: 999px;
      /* Hairline ring as well as the drop shadow: the Book pill is var(--ink)
         and so is every .final section, so on a dark CTA band the pill lost its
         edge entirely and read as loose white text. The ring costs nothing on
         the light ground and gives it a shape on the dark one. */
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.22), 0 10px 30px -8px rgba(17, 18, 20, 0.45);
    }
    /* Footer gains a fifth track for the new Import Guides column. */
    footer .bigfoot { grid-template-columns: 1.4fr repeat(4, 1fr); }
  }
  /* Client-logo rounded corners on every viewport (mobile.css rounds them on
     small screens; this extends the same treatment to desktop). */
  .logos figure, .logos img, .logos .ph { border-radius: 10px; overflow: hidden; }

  /* Enquiry confirmation (2026-09 audit, UX-02). Replaces the form in place on
     a successful send, so the visitor gets a real end state instead of one
     line of small print — and so the WhatsApp hand-off becomes their choice
     rather than a pop-up fired at them. Always inside the dark .final section,
     so it is painted for that ground. */
  .enq-done {
    border: 1px solid rgba(255, 255, 255, .18);
    background: rgba(255, 255, 255, .04);
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .enq-done:focus { outline: 2px solid var(--pass, #0f7a5a); outline-offset: 3px; }
  .enq-done__k {
    font-family: 'JetBrains Mono', monospace;
    font-size: .65rem;
    letter-spacing: .12em;
    color: var(--pass, #0f7a5a);
    margin: 0;
  }
  .enq-done h3 { color: #fff; font-size: 1.25rem; margin: 0; }
  .enq-done p { color: var(--g300, #C9C7C0); margin: 0; max-width: 46ch; font-size: 1rem; }
  .enq-done p b { color: #fff; font-weight: 600; overflow-wrap: anywhere; }
  .enq-done__opt { font-size: .92rem; }
  .enq-done__wa { margin-top: 4px; }
  .final .enq-done__wa { border-color: rgba(255, 255, 255, .35); color: #fff; }
  .final .enq-done__wa:hover { border-color: var(--pass, #0f7a5a); }
</style>
<script>
  import { SITE, waLink } from '../lib/site';

  // Reveal-on-scroll (2026-09 audit, UX-09).
  //
  // The CSS resting state is visible. Previously every .rv sat at opacity 0
  // until the observer fired, so an anchor jump, a shared deep link, a fast
  // scroll, a screenshot renderer or a blocked script all produced blank
  // sections — and three image blocks read as empty placeholders when the
  // photographs were present and simply unrevealed.
  //
  // Now only what is genuinely below the fold at load is hidden, and it is
  // hidden by script, so nothing can be left invisible by a script that never
  // ran. Elements already on screen are marked done without animating.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealables = document.querySelectorAll<HTMLElement>('.rv');
  if (!reduce) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.remove('rv-pending');
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.1, rootMargin: '0px 0px -5% 0px' }
    );
    revealables.forEach((el) => {
      if (el.getBoundingClientRect().top > window.innerHeight) {
        el.classList.add('rv-pending');
        io.observe(el);
      } else {
        el.classList.add('in');
      }
    });
  }

  const mb = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nl = document.querySelector<HTMLElement>('.nav-links');
  if (mb && nl) {
    const close = () => {
      nl.classList.remove('open');
      document.body.classList.remove('nav-open');
      mb.setAttribute('aria-expanded', 'false');
      mb.textContent = 'MENU';
    };
    mb.addEventListener('click', () => {
      const open = nl.classList.toggle('open');
      document.body.classList.toggle('nav-open', open);
      mb.setAttribute('aria-expanded', String(open));
      mb.textContent = open ? 'CLOSE' : 'MENU';
    });
    // close on link tap
    nl.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    // close on Escape, and if the viewport grows past the mobile breakpoint
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }

  // Booking enquiries (2026-09 audit, UX-02).
  //
  // What this used to do: POST to the form backend AND window.open a wa.me
  // link on every submit. On a desktop the pop-up was blocked or the visitor
  // landed on a WhatsApp Web login screen, the button read "Opening
  // WhatsApp…", and the only confirmation was one line of small text. It also
  // read a hardcoded field list, so anything outside svc/cluster/fullname/
  // company/email/phone/date was dropped from both the email and the message.
  //
  // What it does now: POST only, read every named control, and on success swap
  // the form for a confirmation panel that names the address we will reply to
  // and offers WhatsApp as an optional second step. The visitor chooses the
  // channel; nothing is opened for them.
  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.formstatus');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const btnLabel = btn?.textContent ?? 'Send enquiry';

    const setStatus = (text: string, state: string) => {
      if (!status) return;
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      // Honeypot: hidden and untabbable, so anything that fills it is a bot.
      // Drop silently — telling it why would only help it try again.
      const hp = form.querySelector<HTMLInputElement>('[name="_hp"]');
      if (hp?.value) return;

      // Every named control, labelled by its own <label>. Adding a field to
      // EnquiryForm.astro is enough; nothing here needs to know about it.
      const entries: [string, string][] = [];
      form
        .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input[name], select[name], textarea[name]',
        )
        .forEach((el) => {
          if (el.name === '_hp') return;
          const value = el.value?.trim();
          if (!value) return;
          const label =
            form.querySelector(`label[for="${el.id}"]`)?.textContent?.replace(/\s*\(optional\)\s*$/i, '').trim() ||
            el.name;
          entries.push([label, value]);
        });

      const payload: Record<string, string> = {};
      entries.forEach(([label, value]) => { payload[label] = value; });

      const email = payload['Work email'] ?? '';
      const lead = entries[0]?.[1] ?? '';

      if (!SITE.formAccessKey) {
        // No backend configured: send them to a channel that exists rather
        // than pretending the enquiry was captured.
        setStatus(`Email ${SITE.email} or use the WhatsApp button and we will pick it up.`, 'err');
        return;
      }

      setStatus('Sending your enquiry…', 'busy');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

      fetch(SITE.formEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: SITE.formAccessKey,
          subject: `${form.dataset.subject || 'Inspection enquiry'}${lead ? ` — ${lead}` : ''}`,
          from_name: 'qualisassurance.com',
          ...payload,
          page: location.pathname,
        }),
      })
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));

          // GA4 conversion. Guarded: gtag is absent when the ID is unset or a
          // blocker removed it, and a missing analytics tag must never break
          // the confirmation the visitor is waiting for.
          const w = window as unknown as { gtag?: (...a: unknown[]) => void };
          try {
            w.gtag?.('event', 'generate_lead', {
              form_location: location.pathname,
              enquiry_subject: form.dataset.subject || 'Inspection enquiry',
            });
          } catch { /* analytics is never load-bearing */ }

          const panel = document.createElement('div');
          panel.className = 'enq-done';
          panel.setAttribute('role', 'status');
          panel.setAttribute('tabindex', '-1');
          const waText = [
            'Hi Qualis — I just sent an enquiry from the website.',
            ...entries.map(([k, v]) => `${k}: ${v}`),
          ].join('\n');
          panel.innerHTML = `
            <p class="enq-done__k">ENQUIRY RECEIVED</p>
            <h3>We reply within 2 working hours.</h3>
            <p>Your enquiry is with an inspector, not a queue. The reply goes to
              <b>${email ? email.replace(/[<>&"]/g, '') : 'the address you gave'}</b>
              with what we would check, what it costs and when we can be at the factory.</p>
            <p class="enq-done__opt">Prefer to talk now? That is optional — the enquiry is already in.</p>
          `;
          const wa = document.createElement('a');
          wa.className = 'btn btn-ghost enq-done__wa';
          wa.href = waLink(waText);
          wa.target = '_blank';
          wa.rel = 'noopener';
          wa.textContent = 'Continue on WhatsApp';
          panel.appendChild(wa);

          form.replaceWith(panel);
          panel.focus();
        })
        .catch(() => {
          if (btn) { btn.disabled = false; btn.textContent = btnLabel; }
          setStatus(
            `Could not send that. Please email ${SITE.email} or use the WhatsApp button — we will pick it up.`,
            'err',
          );
        });
    });
  });

  // Floating CTA pair steps aside for the booking form (2026-09 audit, UX-10).
  // The pills are a shortcut TO the form; on top of it they are just clutter,
  // and on desktop they overlapped the form note and the pricing cards.
  const stickyCta = document.querySelector<HTMLElement>('.sticky-cta');
  const bookingZone =
    document.querySelector('#book') ?? document.querySelector('form[data-enquiry]')?.closest('section');
  if (stickyCta && bookingZone) {
    const zoneIo = new IntersectionObserver(
      (entries) => entries.forEach((e) => stickyCta.classList.toggle('sticky-cta--off', e.isIntersecting)),
      { threshold: 0 }
    );
    zoneIo.observe(bookingZone);
  }

  const hdEl = document.querySelector('header');
  if (hdEl) {
    const onScroll = () => hdEl.classList.toggle('scrolled', window.scrollY > 10);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>
</body>
</html>
