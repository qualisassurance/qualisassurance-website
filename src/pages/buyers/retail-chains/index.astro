---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';

const title = "Furniture Import Assurance for Retail Chains | QUALIS";
const description = "How Qualis protects retail chains importing furniture from India: vendor programmes your QA team can actually audit.";
const canonical = "https://qualisinspections.com/buyers/retail-chains/";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Furniture Import Assurance for Retail Chains",
    "url": "https://qualisinspections.com/buyers/retail-chains/",
    "description": "How Qualis protects retail chains importing furniture from India: vendor programmes your QA team can actually audit.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Qualis",
      "url": "https://qualisinspections.com"
    },
    "publisher": {
      "@type": "ProfessionalService",
      "name": "Qualis",
      "legalName": "Qualis INC",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jodhpur",
        "addressRegion": "Rajasthan",
        "addressCountry": "IN"
      },
      "telephone": "+918440007574",
      "email": "info@qualisinspections.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://qualisinspections.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Buyers",
        "item": "https://qualisinspections.com/buyers"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Retail Chains",
        "item": "https://qualisinspections.com/buyers/retail-chains/"
      }
    ]
  }
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonld={jsonld} navVariant="inner">
<section class="hero">
<div class="wrap">
<span class="eyebrow">Who we protect</span>
<h1>For retail chains: vendor programmes your QA team can actually audit</h1>
<p class="lead">Chain retail needs repeatability. The same standard applied to every vendor, every order, with documentation your QA and compliance teams can file. We execute your protocol or ours—and being cluster-local means unannounced follow-ups are actually unannounced.</p>
<div class="hero-ctas"><a class="btn btn-solid" href="/#book">Book an inspection</a><a class="btn btn-ghost" href="/why-independent/">Why independent</a></div>
</div>
</section>
<section><div class="wrap"><div class="sec-head"><div><span class="eyebrow">Your assurance stack</span></div></div><div class="grid"><a class="card rv" href="/factory-audit-india/"><h3>Vendor onboarding</h3><p>Verification + factory audit against your own protocol, reported in your format.</p></a><a class="card rv" href="/pre-shipment-inspection-india/"><h3>Programme AQL alignment</h3><p>Your AQL levels, your defect classifications, applied consistently at every PSI.</p></a><a class="card rv" href="/sample-reports/"><h3>Audit trails</h3><p>Photographed, standards-referenced reports that survive your internal compliance review.</p></a></div></div></section><section><div class="wrap prose-wrap"><span class="eyebrow">Start here</span><p class="prose rv">Tell us your product, supplier status and destination market — we'll recommend the right sequence of services and a fixed quote within 2 hours. Every engagement is buyer-paid under our Independence Charter: we take nothing from factories, ever.</p></div></section>
<section class="final">
<div class="wrap">
<span class="eyebrow">Book</span>
<h2>Your next India order. Protected.</h2>
<p>Confirmed within 2 hours. Report within 24 hours of inspection. Paid by buyers only — never by factories.</p>
<a class="btn btn-solid" href="/#book">Book an inspection</a>
</div>
</section>
</BaseLayout>
