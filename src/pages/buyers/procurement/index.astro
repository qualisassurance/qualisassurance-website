const title = "Furniture Import Assurance for Procurement Teams | QUALIS";
const description = "How Qualis protects procurement teams importing furniture from India: independent evidence behind every India PO.";
const canonical = "https://qualisassurance.com/buyers/procurement/";
const jsonld = [
