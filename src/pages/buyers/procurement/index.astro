    "description": "How Qualis protects procurement teams importing furniture from India: independent evidence behind every India PO.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Qualis",
      "url": "https://qualisassurance.com"
    },
    "publisher": {
