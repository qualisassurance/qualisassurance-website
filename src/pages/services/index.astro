    "name": "Furniture Inspection Services in India",
    "numberOfItems": 9,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "url": "https://qualisinspections.com/pre-shipment-inspection-india/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "url": "https://qualisinspections.com/supplier-verification-india/"
      },
      {
        "@type": "ListItem",
