---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

const title = "India Furniture Defect Library | QUALIS";
const description = "A photographic library of Indian furniture defects: moisture cracking, finish bloom, joint failures, hardware shortfalls and loading damage.";
const canonical = "https://qualisassurance.com/defects/";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "India Furniture Defect Library",
    "url": "https://qualisassurance.com/defects/",
    "description": "The photographic library of Indian furniture defects: moisture cracking, finish bloom, joint failures, hardware shortfalls and loading damage — with causes, severity classes and the inspection that catches each.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Qualis",
      "url": "https://qualisassurance.com"
    },
    "publisher": {
      "@type": "ProfessionalService",
      "name": "Qualis",
      "legalName": "Qualis Assurance",
      "priceRange": "$$",
      "sameAs": [
        "https://www.facebook.com/QualisAssurance",
        "https://www.linkedin.com/company/qualisassurance/",
        "https://www.instagram.com/qualisassurance/",
        "https://maps.app.goo.gl/bdA2qD15SzmagDnXA"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C-10, Saraswati Nagar Main Rd, M.I.A. 1st Phase, Basni, Madhuban",
        "addressLocality": "Jodhpur",
        "addressRegion": "Rajasthan",
        "postalCode": "342001",
        "addressCountry": "IN"
      },
      "telephone": "+918440007574",
      "email": "info@qualisassurance.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://qualisassurance.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Defects",
        "item": "https://qualisassurance.com/defects/"
      }
    ]
  }
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonld={jsonld} navVariant="inner">
<section class="hero">
<div class="wrap">
<span class="eyebrow">Resource</span>
<h1>The India Furniture Defect Library</h1>
<p class="lead">Every defect we log gets a photo, a cause, a severity class and the inspection point that catches it. The library grows with every inspection—first 40 entries publishing at launch.</p>
<div class="hero-ctas"><a class="btn btn-solid" href="/#book">Book an inspection</a><a class="btn btn-ghost" href="/why-independent/">Why independent</a></div>
</div>
</section>
<section><div class="wrap"><div class="grid"><a class="card rv" href="/pre-shipment-inspection-india/"><h3>Wood &amp; moisture</h3><p>Cracking, splits, warp and movement from unseasoned or badly kilned timber—the largest claim family.</p></a><a class="card rv" href="/pre-shipment-inspection-india/"><h3>Finish</h3><p>Bloom, blush, colour drift vs golden sample, adhesion failure, over-distressing on "antique" work.</p></a><a class="card rv" href="/pre-shipment-inspection-india/"><h3>Structure &amp; joints</h3><p>Undersized tenons, missing corner blocks, racking failure, unstable bases.</p></a><a class="card rv" href="/pre-shipment-inspection-india/"><h3>Hardware &amp; fit</h3><p>Missing or mismatched fittings, misaligned drawers, failed cycles on moving parts.</p></a><a class="card rv" href="/container-loading-supervision/"><h3>Quantity &amp; documentation</h3><p>Short shipment, wrong SKUs, label and barcode errors.</p></a><a class="card rv" href="/packaging-transit-validation/"><h3>Packaging &amp; loading</h3><p>Failed drop tests, crushed tiers, wet cartons, inadequate dunnage.</p></a></div></div></section><section><div class="wrap prose-wrap"><p class="prose rv">Each entry records: defect ID and family, a macro photograph with measurement annotation, material and process stage, root cause, severity (critical / major / minor per AQL practice), how to specify against it in your PO, and which Qualis service catches it. Buyers use the library two ways—to write tighter specifications before ordering, and to classify what they're looking at when a shipment arrives wrong.</p></div></section>
<section class="final">
<div class="wrap">

<h2>Your next India order. Protected.</h2>
<p>Confirmed within 2 hours. Report within 24 hours of inspection. Paid by buyers only — never by factories.</p>
<a class="btn btn-solid" href="/#book">Book an inspection</a>
</div>
</section>
</BaseLayout>
