---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

const title = "Furniture Import Academy | QUALIS";
const description = "Free, practical training for furniture importers buying from India: first-order playbook, spec templates, payment terms and claim handling.";
const canonical = "https://qualisinspections.com/academy/";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Furniture Import Academy",
    "url": "https://qualisinspections.com/academy/",
    "description": "Free, practical training for furniture importers buying from India: first-order playbook, specification templates, payment terms with inspection clauses, and claim handling.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Qualis",
      "url": "https://qualisinspections.com"
    },
    "publisher": {
      "@type": "ProfessionalService",
      "name": "Qualis",
      "legalName": "Qualis INC",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C-10, Saraswati Nagar Main Rd, M.I.A. 1st Phase, Basni, Madhuban",
        "addressLocality": "Jodhpur",
        "addressRegion": "Rajasthan",
        "postalCode": "342001",
        "addressCountry": "IN"
      },
      "telephone": "+918440007574",
      "email": "info@qualisinspections.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://qualisinspections.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Academy",
        "item": "https://qualisinspections.com/academy/"
      }
    ]
  }
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonld={jsonld} navVariant="inner">
<section class="hero">
<div class="wrap">
<span class="eyebrow">Resource</span>
<h1>The Furniture Import Academy</h1>
<p class="lead">Everything we tell buyers on calls, written down: how to order from India so problems get caught early or never happen. Free, module by module, publishing through Year 1.</p>
<div class="hero-ctas"><a class="btn btn-solid" href="/#book">Book an inspection</a><a class="btn btn-ghost" href="/why-independent/">Why independent</a></div>
</div>
</section>
<section><div class="wrap"><div class="grid"><a class="card rv" href="/first-order-shield/"><h3>The first-order playbook</h3><p>From shortlist to first container: sequencing verification, samples, deposits and inspections so the risk never stacks.</p></a><a class="card rv" href="/#book"><h3>Writing a spec a factory can't misread</h3><p>Dimensions with tolerances, moisture as a number, golden-sample rules, hardware BOMs—templates included.</p></a><a class="card rv" href="/pre-shipment-inspection-india/"><h3>Payment terms that protect you</h3><p>Deposit sizing, milestone payments and the clause that changes behaviour: balance against a passed PSI report.</p></a><a class="card rv" href="/defects/"><h3>When a shipment arrives wrong</h3><p>Evidence, classification, claim letters and the negotiation sequence that actually recovers money.</p></a></div></div></section><section><div class="wrap prose-wrap"><p class="prose rv">Written for importers, e-commerce sellers and buying teams placing their first or their fiftieth India order—practical over theoretical, with downloadable templates in every module. Completing the full track earns a completion certificate; more importantly, it earns you fewer surprises per container.</p></div></section>
<section class="final">
<div class="wrap">

<h2>Your next India order. Protected.</h2>
<p>Confirmed within 2 hours. Report within 24 hours of inspection. Paid by buyers only — never by factories.</p>
<a class="btn btn-solid" href="/#book">Book an inspection</a>
</div>
</section>
</BaseLayout>
