---
/**
 * Contact page. Hand-written, not ported — the reference had no contact page,
 * so this is not in tools/port-manifest.json and a re-port leaves it alone.
 *
 * The enquiry form is deliberately identical to the one on the booking pages:
 * same field names, same data-enquiry="wa" hook, same honeypot and status
 * region, so the handler in BaseLayout drives it with no special-casing and
 * submissions land in the same Web3Forms inbox with the same field names.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { SITE, waLink } from '../../lib/site';
import '../../styles/global.css';

const canonical = 'https://qualisassurance.com/contact/';
const title = 'Contact Qualis — Furniture Inspection in India';
const description =
  'Talk to an independent furniture inspector in India. Call or WhatsApp +91 844 000 7574, or send an enquiry and we reply within 2 hours.';

const org = {
  '@type': 'ProfessionalService',
  name: 'Qualis',
  legalName: 'Qualis Assurance',
  url: SITE.url,
  telephone: SITE.phoneE164,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'C-10, Saraswati Nagar Main Rd, M.I.A. 1st Phase, Basni, Madhuban',
    addressLocality: 'Jodhpur',
    addressRegion: 'Rajasthan',
    postalCode: '342001',
    addressCountry: 'IN',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: SITE.phoneE164,
      email: SITE.email,
      availableLanguage: ['en', 'hi'],
      areaServed: ['US', 'CA', 'GB', 'AU', 'DE', 'NL', 'BE', 'FR', 'DK', 'AE'],
    },
  ],
};

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    url: canonical,
    description,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Qualis', url: SITE.url },
    about: org,
    publisher: org,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: canonical },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonld={jsonld}
  navVariant="inner"
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Talk to an inspector, not a call centre</h1>
      <p class="lead">
        Qualis is on the ground in India's furniture clusters. Tell us the service, the
        factory location and your target date, and we come back with scope and a fixed
        quote — within two hours on a working day.
      </p>
      <div class="hero-ctas"><a class="btn btn-solid" href="#book">Send an enquiry</a><a class="btn btn-ghost" href="/services/">See all services</a></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Reach us directly</h2>
      <div class="contact-cards">
        <a class="contact-card" href={`tel:${SITE.phoneE164}`}>
          <b>Phone / WhatsApp</b>
          <span>{SITE.phoneDisplay}</span>
          <small>Same number for calls and WhatsApp</small>
        </a>
        <a
          class="contact-card"
          href={waLink('Hi Qualis — I would like to talk about an inspection in India.')}
          target="_blank"
          rel="noopener"
        >
          <b>WhatsApp</b>
          <span>Start a chat</span>
          <small>Fastest route during Indian working hours</small>
        </a>
        <a class="contact-card" href={`mailto:${SITE.email}`}>
          <b>Email</b>
          <span>{SITE.email}</span>
          <small>Send specs, drawings or a packing list</small>
        </a>
        <div class="contact-card">
          <b>Based in</b>
          <span>Jodhpur, Rajasthan</span>
          <small>Inspecting across Jodhpur, Jaipur, Saharanpur, Moradabad, Delhi NCR and Kolkata</small>
        </div>
      </div>
    </div>
  </section>

  <section class="final" id="book">
    <div class="wrap final-grid">
      <div>
        <h2>Tell us about your order</h2>
        <p>
          Every enquiry reaches a person, not a queue. We reply with what we would check,
          what it costs and when we can be at the factory.
        </p>
        <p class="mono" style="color:var(--g300)">RESPONSE &lt; 2 HRS · REPORT &lt; 24 HRS · PAID BY BUYERS ONLY</p>
      </div>
      <EnquiryForm
      subject="Inspection enquiry"
      submitLabel="Send enquiry"
      lead={[
        { name: 'svc', label: 'Service', type: 'select', options: ['Pre-Shipment Inspection', 'Container Loading Supervision', 'Supplier Verification', 'Factory Audit', 'Production Monitoring', 'Packaging & Transit Validation', 'Not sure — recommend for me'] },
        { name: 'cluster', label: 'Factory location', type: 'select', options: ['Jodhpur', 'Jaipur', 'Saharanpur', 'Moradabad', 'Delhi NCR', 'Kolkata', 'Other / not sure'] },
        { name: 'product', label: 'Product and quantity', type: 'text', placeholder: 'e.g. 180 sheesham console tables, 1×40ft', wide: true },
      ]}
    />
      <div class="bookdirect">
        <a href={`tel:${SITE.phoneE164}`}><b>Phone/WhatsApp</b><span>{SITE.phoneDisplay}</span></a>
        <a href={`mailto:${SITE.email}`}><b>Email</b><span>{SITE.email}</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
