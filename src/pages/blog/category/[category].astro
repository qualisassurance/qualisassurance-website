---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TermArchive from '../../../components/TermArchive.astro';
import { getUsedTerms, getPostsByTerm } from '../../../lib/wp';
import { SITE } from '../../../lib/site';
import '../../../styles/global.css';
import '../../../styles/blog.css';

/** Only terms that actually have posts, so no empty archive is ever emitted. */
export const getStaticPaths: GetStaticPaths = async () => {
  const terms = await getUsedTerms('categories');
  const out = [];
  for (const t of terms) {
    out.push({
      params: { category: t.slug },
      props: { name: t.name, posts: await getPostsByTerm('categories', t.slug) },
    });
  }
  return out;
};

const { name, posts } = Astro.props as any;
const canonical = `${SITE.url}/blog/category/${Astro.params.category}/`;
const label = 'category' === 'tag' ? `#${name}` : name;
const title = `${name} — Furniture Inspection Field Notes | QUALIS`;
const description = `Qualis field notes filed under ${label}: furniture inspection findings and India import guidance for overseas buyers.`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: canonical,
    description,
    isPartOf: { '@type': 'Blog', name: 'Qualis Field Notes', url: `${SITE.url}/blog/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Field Notes', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: label, item: canonical },
    ],
  },
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonld={jsonld} navVariant="inner">
  <TermArchive kind="category" name={name} posts={posts} />
</BaseLayout>
