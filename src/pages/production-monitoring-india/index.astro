---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

const title = "Furniture Production Monitoring in India | QUALIS";
const description = "Ongoing production monitoring for furniture orders in India: scheduled and unannounced factory visits with photo reports, schedule tracking and early defect alerts.";
const canonical = "https://qualisinspections.com/production-monitoring-india/";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Furniture Production Monitoring in India",
    "url": "https://qualisinspections.com/production-monitoring-india/",
    "description": "Ongoing production monitoring for furniture orders in India: scheduled and unannounced factory visits with photo reports, schedule tracking and early defect alerts.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Qualis",
      "url": "https://qualisinspections.com"
    },
    "publisher": {
      "@type": "ProfessionalService",
      "name": "Qualis",
      "legalName": "Qualis INC",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jodhpur",
        "addressRegion": "Rajasthan",
        "addressCountry": "IN"
      },
      "telephone": "+918440007574",
      "email": "info@qualisinspections.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://qualisinspections.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Production Monitoring India",
        "item": "https://qualisinspections.com/production-monitoring-india/"
      }
    ]
  }
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonld={jsonld} navVariant="inner">
<section class="hero">
<div class="wrap">
<span class="eyebrow">Stage 2 — During production</span>
<h1>Eyes on your order, every week</h1>
<p class="lead">For programme orders and long runs, one inspection isn't oversight. Monitoring puts scheduled and unannounced visits through your entire production—with photo reports at every milestone.</p>
<div class="hero-ctas"><a class="btn btn-solid" href="/#book">Book an inspection</a><a class="btn btn-ghost" href="/why-independent/">Why independent</a></div>
</div>
</section>
<section><div class="wrap"><div class="sec-head"><div><span class="eyebrow">What monitoring includes</span></div></div><div class="grid"><a class="card rv" href="/#book"><h3>Milestone visits</h3><p>Material intake, machining, assembly, finishing, packing—photographed at each stage against the plan.</p></a><a class="card rv" href="/clusters/jodhpur/"><h3>Unannounced checks</h3><p>The visits that keep subcontracting honest—possible only because we're minutes away, not a flight.</p></a><a class="card rv" href="/#book"><h3>Schedule tracking</h3><p>Weekly real-progress reporting so a slipping vessel date is news in week 2, not week 8.</p></a><a class="card rv" href="/during-production-inspection/"><h3>Early defect alerts</h3><p>Problems flagged to you the day they're seen, with the rework conversation held while it's cheap.</p></a></div></div></section><section><div class="wrap prose-wrap"><span class="eyebrow">Who uses it</span><p class="prose rv">Retail chains running repeat programmes, brands with strict spec tolerances, and any buyer whose order spans six weeks or more of production. Monitoring is priced from $199 per visit or as a weekly programme rate; most buyers pair it with a closing pre-shipment inspection so the final AQL check lands on a run that was never allowed to drift.</p></div></section>
<section class="final">
<div class="wrap">
<span class="eyebrow">Book</span>
<h2>Your next India order. Protected.</h2>
<p>Confirmed within 2 hours. Report within 24 hours of inspection. Paid by buyers only — never by factories.</p>
<a class="btn btn-solid" href="/#book">Book an inspection</a>
</div>
</section>
</BaseLayout>
