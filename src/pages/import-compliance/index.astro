---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

const title = "Importing Furniture from India — Compliance Hub | QUALIS";
const description = "Country-by-country compliance for furniture imports from India: US (TSCA, Lacey, Prop 65), UK (BS 5852, UKTR), EU (EUDR, REACH) and Australia.";
const canonical = "https://qualisinspections.com/import-compliance/";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Importing Furniture from India — Compliance Hub",
    "url": "https://qualisinspections.com/import-compliance/",
    "description": "Country-by-country compliance for furniture imports from India: US (TSCA Title VI, Lacey Act, Prop 65), UK (BS 5852 & UKTR), EU (EUDR, REACH, EN standards), Australia (illegal logging rules) and UAE.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Qualis",
      "url": "https://qualisinspections.com"
    },
    "publisher": {
      "@type": "ProfessionalService",
      "name": "Qualis",
      "legalName": "Qualis INC",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C-10, Saraswati Nagar Main Rd, M.I.A. 1st Phase, Basni, Madhuban",
        "addressLocality": "Jodhpur",
        "addressRegion": "Rajasthan",
        "postalCode": "342001",
        "addressCountry": "IN"
      },
      "telephone": "+918440007574",
      "email": "info@qualisinspections.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://qualisinspections.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Import Compliance",
        "item": "https://qualisinspections.com/import-compliance/"
      }
    ]
  }
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonld={jsonld} navVariant="inner">
<section class="hero">
<div class="wrap">
<span class="eyebrow">Resource</span>
<h1>Importing furniture from India: the compliance map</h1>
<p class="lead">What your destination market requires—and what an inspection can verify on the ground before the container ships. Country guides publish through Year 1, starting with the USA, UK and Australia.</p>
<div class="hero-ctas"><a class="btn btn-solid" href="/#book">Book an inspection</a><a class="btn btn-ghost" href="/why-independent/">Why independent</a></div>
</div>
</section>
<section><div class="wrap"><div class="grid"><a class="card rv" href="/#book"><h3>United States</h3><p>Formaldehyde rules for composite wood (TSCA Title VI/CARB), Lacey Act declarations for timber legality, California Prop 65 labelling.</p></a><a class="card rv" href="/#book"><h3>United Kingdom</h3><p>BS 5852 fire safety for upholstered furniture, UK timber regulation due diligence, UKCA-relevant standards.</p></a><a class="card rv" href="/#book"><h3>European Union</h3><p>EUDR deforestation due diligence for timber, REACH substance limits, EN strength &amp; stability standards.</p></a><a class="card rv" href="/#book"><h3>Australia</h3><p>Illegal logging due-diligence rules, AS/NZS references, treated-timber and biosecurity considerations.</p></a><a class="card rv" href="/#book"><h3>UAE &amp; GCC</h3><p>Project and hospitality specifications, conformity documentation for FF&amp;E packages.</p></a><a class="card rv" href="/#book"><h3>All markets</h3><p>ISPM-15 pallets &amp; crating, moisture targets by destination climate, packaging &amp; labelling basics.</p></a></div></div></section><section><div class="wrap prose-wrap"><p class="prose rv">Compliance lives in two places: paperwork and product. We verify the product side on the ground—fire labels physically present on UK-bound upholstery, composite-wood documentation matching what is actually being packed, species and markings consistent with declarations, moisture within the limit for your destination climate. This page is guidance, not legal advice; your customs broker or counsel owns the paperwork side, and we give them the ground truth to file against.</p></div></section>
<section class="final">
<div class="wrap">

<h2>Your next India order. Protected.</h2>
<p>Confirmed within 2 hours. Report within 24 hours of inspection. Paid by buyers only — never by factories.</p>
<a class="btn btn-solid" href="/#book">Book an inspection</a>
</div>
</section>
</BaseLayout>
