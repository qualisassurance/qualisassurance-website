---
/**
 * ImageSlot — the reference's "annotated evidence" image frame.
 *
 * Without `src` it renders the exact dashed placeholder from the static site, so
 * the layout is identical while photography is outstanding. With `src` it serves
 * AVIF → WebP → JPEG from the same basename, at the slot's declared pixel spec.
 * Sizing lives on the parent (e.g. `.hero-fig .ph{aspect-ratio:4/3}`), so adding
 * a photo cannot shift the layout.
 *
 *   <ImageSlot id="IMG-01" spec="1600×1200px · JPG/AVIF" desc="Inspector at bench…" />
 *   <ImageSlot id="IMG-01" … src="/images/img-01.jpg" width={1600} height={1200} eager />
 */
interface Props {
  /** Slot identifier from the reference, e.g. "IMG-01", "IMG-PSI-02", "LOGO". */
  id: string;
  /** Size/format note shown after the id, e.g. "1600×1200px · JPG/AVIF". */
  spec?: string;
  /** The art-direction brief. Its first sentence becomes the alt text. */
  desc?: string;
  /** JPEG URL. Matching .avif and .webp are assumed to sit beside it. */
  src?: string;
  /** Overrides the derived alt text. Pass "" for decorative images. */
  alt?: string;
  width?: number;
  height?: number;
  /** Optional amber callout pinned over the image, e.g. "GAP 2MM". */
  anno?: string;
  /** Inline position for the callout, e.g. "top:40%;right:6%". */
  annoStyle?: string;
  /** Eager-load and prioritise. Use for the one hero image per page. */
  eager?: boolean;
  /** Container element. The reference uses <div> for photos, <figure> for logos. */
  as?: 'div' | 'figure';
}

const {
  id, spec, desc, src, alt, width, height, anno, annoStyle, eager = false, as = 'div',
} = Astro.props;

const Tag = as;
const label = spec ? `${id} · ${spec}` : id;

/**
 * The brief's first sentence describes what is in the shot; the rest is
 * direction for the photographer ("Colour-graded to the muted paper/ink
 * palette"), which is noise in a screen reader. Take the first sentence only.
 */
function altFromDesc(d: string): string {
  const first = d.match(/^[\s\S]*?[.!?](?=\s|$)/);
  return (first ? first[0] : d).trim();
}
const altText = alt ?? (desc ? altFromDesc(desc) : '');

const avif = src?.replace(/\.jpg$/, '.avif');
const webp = src?.replace(/\.jpg$/, '.webp');
---
<Tag class:list={['ph', src && 'has-img']}>
  {src ? (
    <picture>
      <source srcset={avif} type="image/avif" />
      <source srcset={webp} type="image/webp" />
      <img
        src={src}
        alt={altText}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : undefined}
      />
    </picture>
  ) : (
    <div class="ph-spec"><b>{label}</b>{desc && <span>{desc}</span>}</div>
  )}
  {anno && <span class="anno" style={annoStyle}>{anno}</span>}
</Tag>
