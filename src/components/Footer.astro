---
import { FOOTER_COLUMNS, SITE, waLink } from '../lib/site';
import Logo from './Logo.astro';
---
<footer>
  <div class="wrap bigfoot">
    <div class="fcol fbrand">
      <a class="logo" href="/" aria-label="Qualis Inspection — home"><Logo height={34} /></a>
      <p>India's Furniture Import Assurance Partner. Independent inspection and verification on the ground in India's furniture clusters since 2017.</p>
      <p class="mono" style="color:var(--pass)">PAID BY BUYERS. NEVER BY FACTORIES.</p>
      <div class="fcontact">
        <a href={`tel:${SITE.phoneE164}`}><b>Call</b>{SITE.phoneDisplay}</a>
        <a href={waLink('Hi Qualis — I have a question about furniture inspection in India.')} target="_blank" rel="noopener"><b>WhatsApp</b>{SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`}><b>Email</b>{SITE.email}</a>
      </div>
    </div>
    {FOOTER_COLUMNS.map((col) => (
      <div class="fcol">
        <b>{col.heading}</b>
        {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    ))}
  </div>
  <div class="wrap fbase">
    <span>© Qualis INC · Jodhpur, Rajasthan, India</span>
    <span>Serving buyers in USA · UK · Australia · Germany · Netherlands · France · UAE</span>
  </div>
</footer>
