---
/**
 * Brand lockup, inlined rather than referenced as <img>.
 *
 * Matches the final "Qualis Assurance" handoff (Brand Logo Qualis Assurance/
 * assets/qualis-logo-horizontal.svg): QUALIS in ink/paper with the "A" in brand
 * green, ASSURANCE beneath in bold green (700) tracked at 10.6 so its line width
 * matches QUALIS above. The green "A" and green sub-wordmark use {mark}; the
 * QUALIS body uses {wordmark} so the ink/paper tone still flips on dark sections
 * (the handoff's -dark variant only recolors the QUALIS body to paper, keeping
 * both the mark and the green letters green).
 *
 * The wordmark is <text> in Archivo. An SVG loaded via <img> renders in an
 * isolated document with no access to the page's webfonts, so it would silently
 * fall back to Helvetica and change width per platform. Inlining lets the
 * self-hosted Archivo apply, which is what the brand handoff specifies.
 *
 * Geometry (ring, tail, checkmark) is verbatim from the handoff and unchanged
 * across every rebrand — do not re-derive it.
 */
interface Props {
  /** "ink" for light backgrounds (header, footer); "paper" for dark sections. */
  tone?: 'ink' | 'paper';
  /** Rendered height in px. The lockup is 560×100, so width follows at 5.6×. */
  height?: number;
  class?: string;
}
const { tone = 'ink', height = 30, class: className } = Astro.props;
const wordmark = tone === 'paper' ? '#F7F6F2' : '#111214';
const mark = '#0F7A5A';
---
<svg
  class:list={['brand-logo', className]}
  viewBox="0 0 560 100"
  height={height}
  width={height * 5.6}
  role="img"
  aria-label="Qualis Assurance"
  focusable="false"
>
  <g>
    <circle cx="50" cy="50" r="36" fill="none" stroke={mark} stroke-width="11" stroke-dasharray="200 26.2" stroke-dashoffset="-54.5" />
    <line x1="65" y1="65" x2="83" y2="83" stroke={mark} stroke-width="11" />
    <polyline points="34,49 45,60 67,36" fill="none" stroke={mark} stroke-width="10" stroke-linecap="square" stroke-linejoin="miter" />
  </g>
  <text x="112" y="60" font-family="Archivo, Helvetica, sans-serif" font-weight="700" font-size="52" fill={wordmark}>QU<tspan fill={mark}>A</tspan>LIS</text>
  <text x="113" y="86" font-family="Archivo, Helvetica, sans-serif" font-weight="700" font-size="19" letter-spacing="10.6" fill={mark}>ASSURANCE</text>
</svg>
